{
  "name": "codex-token-usage",
  "version": "0.1.0",
  "description": "Local, read-only Codex token usage analytics for Windows.",
  "author": "Nancyingcode",
  "private": true,
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && electron-vite build",
    "build:web": "vite build",
    "build:win": "npm run build && electron-builder --config electron-builder.yml --win nsis --x64",
    "commitlint": "commitlint --from HEAD~1 --to HEAD --verbose",
    "lint": "eslint . --max-warnings=0 && prettier --check . && npm run lint:docs",
    "lint:docs": "node scripts/check-docs.cjs",
    "lint:fix": "eslint . --fix --max-warnings=0 && prettier --write . && npm run lint:docs",
    "lint-staged": "lint-staged",
    "lint:staged": "lint-staged",
    "prepare": "node scripts/prepare-husky.cjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "i18next": "^26.3.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.3.3",
    "vitest": "^2.0.2"
  }
}
